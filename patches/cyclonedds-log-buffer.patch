diff --git a/src/ddsrt/CMakeLists.txt b/src/ddsrt/CMakeLists.txt
index 4acfe61d..fd9d843f 100644
--- a/src/ddsrt/CMakeLists.txt
+++ b/src/ddsrt/CMakeLists.txt
@@ -27,6 +27,11 @@ if(WITH_ZEPHYR_NATIVE_SYNC AND NOT WITH_ZEPHYR)
   message(FATAL_ERROR "WITH_ZEPHYR_NATIVE_SYNC requires WITH_ZEPHYR")
 endif()
 
+set(DDSRT_LOG_BUFFER_SIZE 2048 CACHE STRING "Per-thread DDSRT diagnostic buffer size in bytes")
+if(NOT DDSRT_LOG_BUFFER_SIZE MATCHES "^[0-9]+$" OR DDSRT_LOG_BUFFER_SIZE LESS 64)
+  message(FATAL_ERROR "DDSRT_LOG_BUFFER_SIZE must be an integer of at least 64 bytes")
+endif()
+
 set(source_dir "${CMAKE_CURRENT_SOURCE_DIR}")
 set(binary_dir "${CMAKE_CURRENT_BINARY_DIR}")
 
