@@ -13,6 +13,8 @@
 
 #cmakedefine DDSRT_WITH_LWIP 1
 #cmakedefine DDSRT_WITH_FREERTOS 1
+#define DDSRT_LOG_BUFFER_SIZE @DDSRT_LOG_BUFFER_SIZE@
