+
+	stack_ptr = (char *)ROUND_DOWN((uintptr_t)stack_ptr - z_tls_data_size(),
+				      alignment);
 	z_tls_copy(stack_ptr);
 
 	/*
@@ -31,5 +36,5 @@ size_t arch_tls_stack_setup(struct k_thread *new_thread, char *stack_ptr)
 	 */
 	new_thread->tls = POINTER_TO_UINT(stack_ptr);
 
-	return z_tls_data_size();
+	return stack_end - stack_ptr;
 }
