diff --git a/arch/riscv/core/tls.c b/arch/riscv/core/tls.c
index e9760a5560c..5eb8b925175 100644
--- a/arch/riscv/core/tls.c
+++ b/arch/riscv/core/tls.c
@@ -22,7 +22,12 @@ size_t arch_tls_stack_setup(struct k_thread *new_thread, char *stack_ptr)
 	 * Since we are populating things backwards,
 	 * setup the TLS data/bss area first.
 	 */
