+static rmw_ret_t validate_requested_attachments(
+    const wait_set_data_t *data, const rmw_subscriptions_t *subscriptions,
+    const rmw_guard_conditions_t *guard_conditions, size_t *requested_count,
+    bool *attachments_match)
+{
+  *requested_count = 0U;
+  *attachments_match = true;
+  if (subscriptions != NULL) {
+    if (subscriptions->subscriber_count > data->capacity) {
+      RMW_SET_ERROR_MSG("wait set capacity exceeded");
+      return RMW_RET_INVALID_ARGUMENT;
+    }
+    for (size_t index = 0U; index < subscriptions->subscriber_count; ++index) {
+      if (subscriptions->subscribers[index] == NULL) {
+        RMW_SET_ERROR_MSG("null subscription in wait set");
+        return RMW_RET_INVALID_ARGUMENT;
+      }
+      const endpoint_data_t *endpoint = subscriptions->subscribers[index];
+      if (*requested_count >= data->attached_count ||
+          data->attached[*requested_count] != endpoint->condition) {
+        *attachments_match = false;
+      }
+      ++*requested_count;
+    }
+  }
+  if (guard_conditions != NULL) {
+    if (guard_conditions->guard_condition_count > data->capacity - *requested_count) {
+      RMW_SET_ERROR_MSG("wait set capacity exceeded");
+      return RMW_RET_INVALID_ARGUMENT;
+    }
+    for (size_t index = 0U; index < guard_conditions->guard_condition_count; ++index) {
+      if (guard_conditions->guard_conditions[index] == NULL) {
+        RMW_SET_ERROR_MSG("null guard condition in wait set");
+        return RMW_RET_INVALID_ARGUMENT;
+      }
+      const dds_entity_t entity = *(dds_entity_t *)guard_conditions->guard_conditions[index];
+      if (*requested_count >= data->attached_count ||
+          data->attached[*requested_count] != entity) {
+        *attachments_match = false;
+      }
+      ++*requested_count;
+    }
+  }
+  *attachments_match = *attachments_match && *requested_count == data->attached_count;
+  return RMW_RET_OK;
+}
