/*
 * Keep the application console on the ESP32-S3 native USB Serial/JTAG port.
 * This is the same port used by the ROM loader and remains available on
 * boards that do not populate a separate USB-to-UART bridge.
 */

/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};
};

&usb_serial {
	status = "okay";
};

&flash0 {
	reg = <0x0 DT_SIZE_M(32)>;
};

&psram0 {
	size = <DT_SIZE_M(16)>;
};
