{
  "schema_version": 2,
  "name": "static_control",
  "domain_id": 95,
  "node": {
    "name": "static_control",
    "namespace": ""
  },
  "rmw": ["rmw_cyclonedds_c", "rmw_zenoh_pico"],
  "message_profile": "fixed_size",
  "graph": {
    "outbound": false,
    "inbound": false,
    "api": []
  },
  "resources": {
    "local_endpoints": 2,
    "remote": {
      "participants": 0,
      "nodes": 0,
      "endpoints": 0
    },
    "workers": {
      "maximum": 8
    },
    "application": {
      "static_reserve_bytes": 16384
    },
    "targets": {
      "native_sim/native/64": {
        "flash_bytes": 900000,
        "ram_bytes": 1400000
      },
      "esp32_devkitc/esp32/procpu": {
        "flash_bytes": 1200000,
        "ram_bytes": 320000
      },
      "esp32s3_devkitc/esp32s3/procpu": {
        "flash_bytes": 1100000,
        "ram_bytes": 300000
      }
    }
  },
  "endpoints": [
    {
      "id": "command",
      "kind": "subscription",
      "topic": "static_control/command",
      "type": "ros2_zephyr_test_msgs/msg/ControlCommand",
      "callback": "command_callback",
      "qos": {
        "reliability": "best_effort",
        "durability": "volatile",
        "history": "keep_last",
        "depth": 1
      },
      "lifetime": "fixed_startup"
    },
    {
      "id": "state",
      "kind": "publisher",
      "topic": "static_control/state",
      "type": "ros2_zephyr_test_msgs/msg/ControlState",
      "qos": {
        "reliability": "best_effort",
        "durability": "volatile",
        "history": "keep_last",
        "depth": 1
      },
      "lifetime": "fixed_startup"
    }
  ]
}
