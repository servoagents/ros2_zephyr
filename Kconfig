menuconfig ROS2_ZEPHYR
    bool "ROS 2 with direct Cyclone DDS"
    default n
    help
      Build the fixed-size rclc/rcl/rmw_cyclonedds_c runtime and link it
      directly with Cyclone DDS. This configuration does not use an XRCE
      Agent.

if ROS2_ZEPHYR

config ROS2_ZEPHYR_RMW_CYCLONEDDS_C
    bool "Use rmw_cyclonedds_c"
    default y
    help
      Select the current Cyclone DDS C middleware backend. Other backends are
      not implemented.

config ROS2_ZEPHYR_DOMAIN_ID
    int "ROS domain ID"
    range 0 232
    default 95

config ROS2_ZEPHYR_CYCLONEDDS_THREAD_COUNT
    int "Maximum Cyclone DDS worker threads"
    range 1 16
    default 8 if ARCH_POSIX
    default 5

config ROS2_ZEPHYR_CYCLONEDDS_THREAD_STACK_SIZE
    int "Cyclone DDS worker stack size"
    range 2048 131072
    default 65536 if ARCH_POSIX
    default 8192
    help
      Stack reserved for each Cyclone DDS worker. The embedded default covers
      discovery against an external DDS peer on ESP32-S3. Applications with a
      measured local-only workload may select a smaller value.

config ROS2_ZEPHYR_GRAPH_MAX_LOCAL_NODES
    int "Maximum local nodes in one ROS graph announcement"
    range 1 16
    default 4

config ROS2_ZEPHYR_GRAPH_MAX_ENDPOINTS_PER_NODE
    int "Maximum graph endpoints associated with one node"
    range 1 32
    default 8

config ROS2_ZEPHYR_GRAPH_CACHE_MAX_PARTICIPANTS
    int "Maximum participants in the inbound ROS graph cache"
    range 1 16
    default 4

config ROS2_ZEPHYR_GRAPH_CACHE_MAX_NODES
    int "Maximum nodes in the inbound ROS graph cache"
    range 1 32
    default 8

config ROS2_ZEPHYR_GRAPH_CACHE_MAX_ENDPOINTS
    int "Maximum DDS endpoints in the inbound ROS graph cache"
    range 1 64
    default 24
    help
      DDS endpoints are retained before their ROS graph association arrives,
      so this limit must also cover temporarily unassociated endpoints.

endif
