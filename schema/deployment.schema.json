{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://servoagents.dev/ros2-zephyr/deployment.schema.json",
  "title": "ROS 2 Zephyr fixed deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "domain_id", "node", "rmw", "message_profile", "graph", "endpoints"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "domain_id": {"type": "integer", "minimum": 0, "maximum": 232},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "namespace": {"type": "string"}
      }
    },
    "rmw": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["rmw_cyclonedds_c", "rmw_zenoh_pico"]}},
    "message_profile": {"const": "fixed_size"},
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outbound", "inbound", "api"],
      "properties": {
        "outbound": {"type": "boolean"},
        "inbound": {"type": "boolean"},
        "api": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "topic", "type", "qos", "lifetime"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "kind": {"enum": ["publisher", "subscription"]},
          "topic": {"type": "string"},
          "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*/msg/[A-Za-z][A-Za-z0-9_]*$"},
          "callback": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "lifetime": {"const": "fixed_startup"},
          "qos": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reliability", "durability", "history", "depth"],
            "properties": {
              "reliability": {"enum": ["best_effort", "reliable"]},
              "durability": {"enum": ["volatile", "transient_local"]},
              "history": {"const": "keep_last"},
              "depth": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
